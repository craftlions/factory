#!/usr/bin/env bash
#MISE description="Bump the version everywhere, commit, tag, and push (triggers the APT publish)"
#USAGE arg "<version>" help="Version to release, e.g. 0.1.0 or v0.1.0"
set -euo pipefail

# shellcheck disable=SC2154 # mise sets usage_version from the USAGE spec
version="${usage_version#v}"
if ! [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "error: version must look like 1.2.3, got '$usage_version'" >&2
    exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
    echo "error: working tree is not clean" >&2
    exit 1
fi
if [[ "$(git branch --show-current)" != "main" ]]; then
    echo "error: release from main" >&2
    exit 1
fi
if git rev-parse -q --verify "refs/tags/v$version" >/dev/null \
    || git ls-remote --exit-code --tags origin "v$version" >/dev/null 2>&1; then
    echo "error: tag v$version already exists" >&2
    exit 1
fi

export RELEASE_VERSION="$version"
# Only the [package] version starts at column 0; dependency versions are indented or inline.
perl -pi -e 's/^version = "[^"]+"/version = "$ENV{RELEASE_VERSION}"/' Cargo.toml
# Replace only the first "version" key, which is the package's own.
perl -pi -e 's/"version": "[^"]+"/"version": "$ENV{RELEASE_VERSION}"/ && $done++ unless $done' ui/package.json
cargo update --workspace --offline >/dev/null

git add Cargo.toml Cargo.lock ui/package.json
git commit -q -m "release v$version"
git tag "v$version"
git push origin main "v$version"
echo "released v$version"
